# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (Ruby · Rails 8 (API)).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 3000; probes: liveness /health, readiness /health.

FROM ruby:3.3 AS build
WORKDIR /app
ENV BUNDLE_WITHOUT=development:test
COPY Gemfile* ./
RUN bundle install --jobs 4 --quiet
COPY . .

FROM ruby:3.3-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /usr/local/bundle /usr/local/bundle
WORKDIR /app
COPY --from=build --chown=10001 /app /app
RUN mkdir -p /app/tmp /app/log && chown -R 10001 /app/tmp /app/log
# SECRET_KEY_BASE must be provided by the platform (secret manager).
ENV RAILS_ENV=production RAILS_LOG_TO_STDOUT=1 BUNDLE_WITHOUT=development:test PORT=3000
USER 10001
EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
